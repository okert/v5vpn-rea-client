{
  "name": "v5vpn-rea",
  "identifier": "io.github.hygkui.v5vpn-rea",
  "version": "0.1.10",
  "frontendDist": "internal/cmd/ui",
  "macos": {
    "entitlements": "macos.entitlements.plist",
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true,
        "NSAllowsLocalNetworking": true,
        "NSExceptionDomains": {
          "127.0.0.1": {
            "NSExceptionAllowsInsecureHTTPLoads": true,
            "NSIncludesSubdomains": true
          },
          "localhost": {
            "NSExceptionAllowsInsecureHTTPLoads": true,
            "NSIncludesSubdomains": true
          }
        }
      }
    }
  },
  "copyright": "Copyright 2026 hygkui and contributors",
  "main": "./internal/cmd",
  "out": "build",
  "updates": {
    "publicKey": "v5XetXmz4jCAgqdZ83E8ygOZsv2bEDO0PRf0rRYyXcA=",
    "github": "hygkui/v5vpn-rea-client",
    "tagPrefix": "v",
    "deltas": 3
  },
  "linux": {
    "maintainer": "hygkui <hygkui@users.noreply.github.com>",
    "comment": "Unofficial V5VPN SSL VPN portal client",
    "categories": ["Network", "Utility"],
    "depends": ["libwebkit2gtk-4.1-0"]
  }
}
